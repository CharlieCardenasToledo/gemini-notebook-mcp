{
  "name": "@charlie.act7/gemini-notebook-mcp",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.3.5",
  "description": "MCP server for Google Gemini Notebook (formerly NotebookLM) — chat, source ingestion, audio overviews, citations, stdio + Streamable-HTTP transports.",
  "type": "module",
  "bin": {
    "gemini-notebook-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "prepare": "npm run build",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "mcp:smoke": "node scripts/mcp-client.mjs health",
    "mcp:auth": "node scripts/mcp-client.mjs auth",
    "mcp:ask": "node scripts/mcp-client.mjs ask",
    "mcp:inspect": "node scripts/inspect-live-chat.mjs",
    "mcp:test-live": "node scripts/live-readonly-smoke.mjs",
    "mcp:test-live:chat": "node scripts/test-live-chat.mjs",
    "pretest:live:readonly": "npm run build",
    "test:live:readonly": "node scripts/live-readonly-smoke.mjs",
    "pretest:live:preflight": "npm run build",
    "test:live:preflight": "node scripts/live-readonly-smoke.mjs --preflight-only",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check": "npm run format:check && npm run lint && npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "notebooklm",
    "gemini",
    "gemini-notebook",
    "ai",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlieCardenasToledo/gemini-notebook-mcp.git"
  },
  "homepage": "https://github.com/CharlieCardenasToledo/gemini-notebook-mcp#readme",
  "bugs": {
    "url": "https://github.com/CharlieCardenasToledo/gemini-notebook-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "npm-shrinkwrap.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "env-paths": "^3.0.0",
    "patchright": "1.61.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.2.1",
    "linkedom": "^0.18.13",
    "prettier": "^3.8.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
